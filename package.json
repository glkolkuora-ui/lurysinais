{
  "name": "genesis-web",
  "version": "1.0.0",
  "private": true,
  "description": "Genesis — mesmo painel do Genesis, com o bot rodando no servidor",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@quadcode-tech/client-sdk-js": "^1.3.21",
    "@supabase/supabase-js": "^2.105.4",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "lightweight-charts": "^5.2.0",
    "pg": "^8.23.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^8.0.12"
  }
}
